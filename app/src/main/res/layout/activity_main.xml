<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingTop="44dp"
    android:paddingEnd="40dp"
    android:paddingBottom="36dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0"
            android:text="@string/product_label"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sdk_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0"
            android:text="@string/sdk_pending"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:id="@+id/status_indicator"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/status_indicator"
        android:contentDescription="@string/status_indicator_description" />

    <TextView
        android:id="@+id/status_title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0"
        android:text="@string/status_idle"
        android:textColor="@color/text_primary"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/status_detail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif"
        android:gravity="center_horizontal|top"
        android:letterSpacing="0"
        android:maxLines="2"
        android:text="@string/status_idle_detail"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/stream_stats"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0"
        android:maxLines="1"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <Button
        android:id="@+id/retry_button"
        android:layout_width="168dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/retry_button_background"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0"
        android:text="@string/retry"
        android:textAllCaps="false"
        android:textColor="@color/retry_button_text"
        android:textSize="16sp"
        android:visibility="invisible" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/runtime_identity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0"
        android:text="@string/runtime_identity"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

</LinearLayout>
